# --- LLM providers (at least one required) ---
# OpenRouter is primary. Every model in the chain is a :free variant.
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Optional fallbacks, tried in provider order: openrouter -> groq -> xai
GROQ_API_KEY=gsk_your_key_here
XAI_API_KEY=xai_your_key_here

# Which provider to prefer, and the model to try first on it.
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Web search (optional, falls back to Wikipedia) ---
TAVILY_API_KEY=tvly-your_key_here

# --- Service ---
API_KEY=your-api-key-here
PORT=8000

# --- Safety / reliability ---
# off = run everything except hard denies | ask = surface risky calls | enforce = block
PERMISSION_MODE=ask
TOOL_MAX_RETRIES=2
TOOL_RETRY_BASE_DELAY=0.5
TOOL_CIRCUIT_BREAKER_THRESHOLD=3
TOOL_CIRCUIT_BREAKER_COOLDOWN=30
TOOL_OUTPUT_MAX_CHARS=8000
MAX_CONTEXT_TOKENS=24000
